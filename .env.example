# 复制为 .env 并填入你的 key（.env 不会被提交）
GEMINI_API_KEY=

# 访问控制：每个测试用户一个邀请码。格式 "名字:邀请码"，逗号分隔。
# 例：alice 用码 a1b2，bob 用码 c3d4
# ACCESS_USERS=alice:a1b2,bob:c3d4
# （兼容老配置）只想要一个共用密码时，仍可用 ACCESS_PASSWORD=xxxx，会记到用户「我」名下
# 本地都不填 = 不限制、用户名记为「本机」

# 用量按用户存到 Supabase（不填则退回本地文件 data/usage.json，仅本地有效）
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_KEY=（Supabase 项目的 service_role key，是机密，别提交）

# 可选：覆盖默认模型
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# GEMINI_VISION_MODEL=gemini-2.5-flash
